{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "next-notepad",
  "version": "0.3.0",
  "identifier": "com.nextnotepad.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "next-notepad",
        "width": 1100,
        "height": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "publisher": "Mariswamy Pillai",
    "copyright": "© 2026 Mariswamy Pillai",
    "shortDescription": "A fast, cross-platform text and code editor"
  }
}
