{
  "_doc": "Shared cross-engine table (ADR-0003). Run by Vitest (JS engine) and cargo test (Rust engine). 'matches' lists the matched strings in order; needsJs cases are only matched by the JS engine and the Rust side must flag them.",
  "matchCases": [
    {
      "name": "normal: dot is literal",
      "pattern": "a.b",
      "mode": "normal",
      "text": "a.b axb",
      "matches": [
        "a.b"
      ]
    },
    {
      "name": "normal: parentheses are literal",
      "pattern": "(x)",
      "mode": "normal",
      "text": "a(x)b x",
      "matches": [
        "(x)"
      ]
    },
    {
      "name": "normal: case-insensitive by default",
      "pattern": "foo",
      "mode": "normal",
      "text": "Foo foo FOO",
      "matches": [
        "Foo",
        "foo",
        "FOO"
      ]
    },
    {
      "name": "normal: match case",
      "pattern": "foo",
      "mode": "normal",
      "matchCase": true,
      "text": "Foo foo FOO",
      "matches": [
        "foo"
      ]
    },
    {
      "name": "normal: whole word",
      "pattern": "cat",
      "mode": "normal",
      "wholeWord": true,
      "text": "cat concat cat.",
      "matches": [
        "cat",
        "cat"
      ]
    },
    {
      "name": "normal: whole word with non-word edge needs JS",
      "pattern": "@foo",
      "mode": "normal",
      "wholeWord": true,
      "text": "a@foo @foo",
      "matches": [
        "@foo"
      ],
      "needsJs": true
    },
    {
      "name": "extended: newline escape",
      "pattern": "a\\nb",
      "mode": "extended",
      "text": "a\nb ab",
      "matches": [
        "a\nb"
      ]
    },
    {
      "name": "extended: tab escape",
      "pattern": "a\\tb",
      "mode": "extended",
      "text": "a\tb a b",
      "matches": [
        "a\tb"
      ]
    },
    {
      "name": "extended: hex escape",
      "pattern": "\\x41",
      "mode": "extended",
      "matchCase": true,
      "text": "AaA",
      "matches": [
        "A",
        "A"
      ]
    },
    {
      "name": "extended: escaped backslash",
      "pattern": "a\\\\b",
      "mode": "extended",
      "text": "a\\b ab",
      "matches": [
        "a\\b"
      ]
    },
    {
      "name": "extended: regex metacharacters stay literal",
      "pattern": "a.b",
      "mode": "extended",
      "text": "a.b axb",
      "matches": [
        "a.b"
      ]
    },
    {
      "name": "regex: digits",
      "pattern": "\\d+",
      "mode": "regex",
      "text": "a12 b345",
      "matches": [
        "12",
        "345"
      ]
    },
    {
      "name": "regex: groups",
      "pattern": "(\\w+)@(\\w+)",
      "mode": "regex",
      "text": "me@host you@site",
      "matches": [
        "me@host",
        "you@site"
      ]
    },
    {
      "name": "regex: caret matches at each line start",
      "pattern": "^foo",
      "mode": "regex",
      "text": "foo\nfoo\nxfoo",
      "matches": [
        "foo",
        "foo"
      ]
    },
    {
      "name": "regex: dollar matches at each line end",
      "pattern": "foo$",
      "mode": "regex",
      "text": "foo\nxfoo\nfoo bar",
      "matches": [
        "foo",
        "foo"
      ]
    },
    {
      "name": "regex: dot does not match newline by default",
      "pattern": "a.b",
      "mode": "regex",
      "text": "a\nb",
      "matches": []
    },
    {
      "name": "regex: dot matches newline when enabled",
      "pattern": "a.b",
      "mode": "regex",
      "dotMatchesNewline": true,
      "text": "a\nb",
      "matches": [
        "a\nb"
      ]
    },
    {
      "name": "regex: horizontal whitespace \\h",
      "pattern": "a\\h+b",
      "mode": "regex",
      "text": "a \t b a\nb",
      "matches": [
        "a \t b"
      ]
    },
    {
      "name": "regex: any line break \\R",
      "pattern": "a\\Rb",
      "mode": "regex",
      "text": "a\r\nb a\nb a\rb ab",
      "matches": [
        "a\r\nb",
        "a\nb",
        "a\rb"
      ]
    },
    {
      "name": "regex: hex code point \\x{41}",
      "pattern": "\\x{41}",
      "mode": "regex",
      "matchCase": true,
      "text": "AaA",
      "matches": [
        "A",
        "A"
      ]
    },
    {
      "name": "regex: named group (?<n>)",
      "pattern": "(?<y>\\d{4})",
      "mode": "regex",
      "text": "in 2024 and 1999",
      "matches": [
        "2024",
        "1999"
      ]
    },
    {
      "name": "regex: named group (?P<n>)",
      "pattern": "(?P<y>\\d{4})",
      "mode": "regex",
      "text": "in 2024 and 1999",
      "matches": [
        "2024",
        "1999"
      ]
    },
    {
      "name": "regex: case-insensitive by default",
      "pattern": "FOO",
      "mode": "regex",
      "text": "foo Foo",
      "matches": [
        "foo",
        "Foo"
      ]
    },
    {
      "name": "regex: match case",
      "pattern": "FOO",
      "mode": "regex",
      "matchCase": true,
      "text": "foo FOO",
      "matches": [
        "FOO"
      ]
    },
    {
      "name": "regex: alternation",
      "pattern": "cat|dog",
      "mode": "regex",
      "text": "a cat and a dog",
      "matches": [
        "cat",
        "dog"
      ]
    },
    {
      "name": "regex: character class keeps literal parens",
      "pattern": "[(]x",
      "mode": "regex",
      "text": "(x x",
      "matches": [
        "(x"
      ]
    },
    {
      "name": "regex: lookahead needs JS",
      "pattern": "foo(?=bar)",
      "mode": "regex",
      "text": "foobar foobaz",
      "matches": [
        "foo"
      ],
      "needsJs": true
    },
    {
      "name": "regex: negative lookahead needs JS",
      "pattern": "foo(?!bar)",
      "mode": "regex",
      "text": "foobar foobaz",
      "matches": [
        "foo"
      ],
      "needsJs": true
    },
    {
      "name": "regex: lookbehind needs JS",
      "pattern": "(?<=\\$)\\d+",
      "mode": "regex",
      "text": "$12 and 34",
      "matches": [
        "12"
      ],
      "needsJs": true
    },
    {
      "name": "regex: backreference needs JS",
      "pattern": "(\\w)\\1",
      "mode": "regex",
      "text": "aab abc ccd",
      "matches": [
        "aa",
        "cc"
      ],
      "needsJs": true
    },
    {
      "name": "regex: whole word needs JS",
      "pattern": "\\d+",
      "mode": "regex",
      "wholeWord": true,
      "text": "12 a1 34",
      "matches": [
        "12",
        "34"
      ],
      "needsJs": true
    },
    {
      "name": "extended: \\r\\n matches a line break (text is LF-normalised)",
      "pattern": "\\r\\n",
      "mode": "extended",
      "text": "a\nb\nc",
      "matches": [
        "\n",
        "\n"
      ]
    },
    {
      "name": "extended: lone \\r matches a line break",
      "pattern": "a\\rb",
      "mode": "extended",
      "text": "a\nb",
      "matches": [
        "a\nb"
      ]
    },
    {
      "name": "regex: \\r\\n matches a line break",
      "pattern": "a\\r\\nb",
      "mode": "regex",
      "text": "a\nb",
      "matches": [
        "a\nb"
      ]
    },
    {
      "name": "regex: \\r?\\n matches exactly one line break",
      "pattern": "a\\r?\\nb",
      "mode": "regex",
      "text": "a\nb a\n\nb",
      "matches": [
        "a\nb"
      ]
    },
    {
      "name": "regex: [\\r\\n]+ matches runs of line breaks",
      "pattern": "[\\r\\n]+",
      "mode": "regex",
      "text": "a\n\nb\nc",
      "matches": [
        "\n\n",
        "\n"
      ]
    }
  ],
  "replaceCases": [
    {
      "name": "regex: swap with backslash groups",
      "pattern": "(\\w+) (\\w+)",
      "mode": "regex",
      "replacement": "\\2 \\1",
      "text": "hello world",
      "result": "world hello"
    },
    {
      "name": "regex: swap with dollar groups",
      "pattern": "(\\w+) (\\w+)",
      "mode": "regex",
      "replacement": "$2 $1",
      "text": "hello world",
      "result": "world hello"
    },
    {
      "name": "regex: whole match with \\0",
      "pattern": "\\d+",
      "mode": "regex",
      "replacement": "[\\0]",
      "text": "a1 b22",
      "result": "a[1] b[22]"
    },
    {
      "name": "regex: whole match with $0",
      "pattern": "\\d+",
      "mode": "regex",
      "replacement": "[$0]",
      "text": "a1 b22",
      "result": "a[1] b[22]"
    },
    {
      "name": "regex: newline escape in replacement",
      "pattern": ",",
      "mode": "regex",
      "replacement": "\\n",
      "text": "a,b",
      "result": "a\nb"
    },
    {
      "name": "regex: tab escape in replacement",
      "pattern": ",",
      "mode": "regex",
      "replacement": "\\t",
      "text": "a,b",
      "result": "a\tb"
    },
    {
      "name": "regex: escaped backslash in replacement",
      "pattern": ",",
      "mode": "regex",
      "replacement": "\\\\",
      "text": "a,b",
      "result": "a\\b"
    },
    {
      "name": "regex: group that did not participate becomes empty",
      "pattern": "a(x)?b",
      "mode": "regex",
      "replacement": "[\\1]",
      "text": "ab axb",
      "result": "[] [x]"
    },
    {
      "name": "regex: unknown escape is kept",
      "pattern": "a",
      "mode": "regex",
      "replacement": "\\q",
      "text": "a",
      "result": "\\q"
    },
    {
      "name": "regex: group index is a single digit",
      "pattern": "(a)",
      "mode": "regex",
      "replacement": "$10",
      "text": "a",
      "result": "a0"
    },
    {
      "name": "normal: replacement is literal",
      "pattern": "a",
      "mode": "normal",
      "replacement": "\\1$1\\n",
      "text": "a",
      "result": "\\1$1\\n"
    },
    {
      "name": "extended: newline and tab in replacement",
      "pattern": ",",
      "mode": "extended",
      "replacement": "\\n\\t",
      "text": "a,b",
      "result": "a\n\tb"
    },
    {
      "name": "extended: no group references",
      "pattern": "a",
      "mode": "extended",
      "replacement": "\\1",
      "text": "a",
      "result": "\\1"
    },
    {
      "name": "extended: replace \\r\\n with a comma (join lines)",
      "pattern": "\\r\\n",
      "mode": "extended",
      "replacement": ",",
      "text": "asdasd\nadad\nasdlkasdkl\nasdlkas\nasdad",
      "result": "asdasd,adad,asdlkasdkl,asdlkas,asdad"
    },
    {
      "name": "extended: replacement \\r\\n inserts one line break",
      "pattern": ",",
      "mode": "extended",
      "replacement": "\\r\\n",
      "text": "a,b",
      "result": "a\nb"
    },
    {
      "name": "regex: replacement \\r\\n inserts one line break",
      "pattern": ",",
      "mode": "regex",
      "replacement": "\\r\\n",
      "text": "a,b",
      "result": "a\nb"
    }
  ]
}
